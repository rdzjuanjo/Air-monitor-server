# Servidor de actualizaciones OTA (ESP32OTAPull) - ota.${DOMAIN}

server {
    listen 80;
    listen [::]:80;
    server_name ota.${DOMAIN};

    # Binarios por HTTP plano: el firmware 1.0.0 desborda el stack al hacer el
    # segundo handshake TLS para descargar el .bin (ESP32OTAPull::DoOTAUpdate).
    # El manifiesto .json sigue sirviéndose solo por HTTPS.
    location ~ ^/[^/]+\.bin$ {
        root /usr/share/nginx/ota;
    }

    include /etc/nginx/snippets/acme-redirect.conf;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ota.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /usr/share/nginx/ota;

    location / {
        autoindex off;
        try_files $uri =404;
    }
}
